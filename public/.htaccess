# public/.htaccess

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # 1. Jika file atau folder beneran ADA (seperti CSS, gambar, atau file SSG valid)
    # Langsung izinkan Apache untuk meloadnya secara normal!
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Jika nyasar di rute /id/... -> load 404.html versi Indo secara senyap
    RewriteCond %{REQUEST_URI} ^/id/
    RewriteRule ^ /id/404.html [L]

    # 3. Sisanya (Nyasar di rute default/Inggris) -> load 404.html versi Inggris
    RewriteRule ^ /404.html [L]
</IfModule>